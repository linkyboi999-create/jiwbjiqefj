local function applyRGB(stroke)
    task.spawn(function()
        local hue = 0
        while stroke and stroke.Parent do
            hue = (hue + 0.005) % 1
            stroke.Color = Color3.fromHSV(hue, 1, 1)
            task.wait(0.02)
        end
    end)
end

